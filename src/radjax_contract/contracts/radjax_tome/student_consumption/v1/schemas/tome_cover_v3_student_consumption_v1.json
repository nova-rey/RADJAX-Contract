{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radjax_tome_cover_v3_student_consumption_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "training", "package", "manifests", "authority", "provenance", "validation", "student_consumption"],
  "properties": {
    "schema_version": {"const": "radjax_tome_cover_v3_student_consumption_v1"},
    "identity": {"type": "object"},
    "training": {"type": "object"},
    "package": {"type": "object"},
    "manifests": {"type": "object"},
    "authority": {"type": "object"},
    "provenance": {"type": "object"},
    "validation": {"type": "object"},
    "student_consumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "manifest_path", "manifest_sha256", "semantic_digest"],
      "properties": {
        "profile_id": {"const": "native_v3_student_v1"},
        "manifest_path": {"const": "manifests/student_consumption_v1.json"},
        "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "semantic_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
