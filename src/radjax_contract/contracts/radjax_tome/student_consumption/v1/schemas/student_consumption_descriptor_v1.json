    "profile_id": {"const": "native_v3_student_v1"},
    "base_artifact_semantic_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "consumption_semantic_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "vocabulary": {"type": "object"},
    "sequence": {"type": "object"},
    "corridor_resources": {"type": "array", "items": {"type": "object"}},
    "exemplar_resources": {"type": "array", "items": {"type": "object"}},
    "joins": {"type": "array", "items": {"type": "object"}},
    "delivery": {"type": "object"},
    "provenance": {"type": "object"},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "nonclaims": {"type": "array", "items": {"type": "string"}}
  }
}
