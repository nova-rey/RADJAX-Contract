{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radjax.dev/contracts/radjax_tome/student_consumption/v1/schemas/student_consumption_profile_v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "requires_surfaces", "accepted_package_profiles", "accepted_transports", "role_authority", "required_batch_roles", "required_validation_roles", "optional_diagnostic_roles", "numeric_policy"],
  "properties": {
    "schema_version": {"const": "radjax_tome_student_consumption_profile_v1"},
    "profile_id": {"const": "native_v3_student_v1"},
    "requires_surfaces": {"const": ["corridor", "exemplar"]},
    "accepted_package_profiles": {"type": "array", "items": {"enum": ["unpacked", "student", "full_debug_provenance"]}, "uniqueItems": true},
    "accepted_transports": {"type": "array", "items": {"enum": ["directory", "rtome", "tgz"]}, "uniqueItems": true},
    "role_authority": {"const": "role_and_instance_not_physical_path"},
    "required_batch_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_validation_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "optional_diagnostic_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "numeric_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probability_atol", "probability_rtol", "log_probability_atol", "log_probability_rtol", "inactive_token_id", "inactive_probability", "inactive_log_probability"],
      "properties": {
        "probability_atol": {"type": "number", "minimum": 0},
        "probability_rtol": {"type": "number", "minimum": 0},
        "log_probability_atol": {"type": "number", "minimum": 0},
        "log_probability_rtol": {"type": "number", "minimum": 0},
        "inactive_token_id": {"type": "integer", "minimum": 0},
        "inactive_probability": {"const": 0.0},
        "inactive_log_probability": {"const": -100.0}
      }
    }
  }
}
