{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "radjax_tome_student_consumption_manifest_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "base_artifact_semantic_digest", "semantic_identity", "resources", "joins", "provenance"],
  "properties": {
    "schema_version": {"const": "radjax_tome_student_consumption_manifest_v1"},
    "profile_id": {"const": "native_v3_student_v1"},
    "base_artifact_semantic_digest": {"$ref": "#/$defs/sha256"},
    "semantic_identity": {"$ref": "student_consumption_semantic_identity_v1.json"},
    "resources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resource"}},
    "joins": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "role", "instance_id", "semantic_digest", "training_payload_binding", "inventory_binding", "encoding", "classification", "consumption"],
      "properties": {
        "resource_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "instance_id": {"type": "string", "minLength": 1},
        "semantic_digest": {"$ref": "#/$defs/sha256"},
        "training_payload_binding": {"type": "string", "minLength": 1},
        "inventory_binding": {"type": "string", "minLength": 1},
        "encoding": {"enum": ["json", "jsonl", "npy", "npz"]},
        "classification": {"enum": ["batch", "validation", "diagnostic", "provenance"]},
        "consumption": {"type": "object"}
      }
    }
  }
}
